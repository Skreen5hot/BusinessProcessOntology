@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix bpo:  <https://fandaws.com/ontology/bpo#> .

# Reused good fillers (minimal declarations)
bpo:CompetitorAnalysis a owl:Class ; rdfs:subClassOf cco:ont00000853 .
bpo:CompetitorRole     a owl:Class ; rdfs:subClassOf obo:BFO_0000023 .
bpo:CompetitorData     a owl:Class ; rdfs:subClassOf cco:ont00000853 .
bpo:Competitor         a owl:Class ; rdfs:subClassOf cco:ont00001180 .

# V-S2: a process with NO CCO Act anchor (+ V-S1: no label/def/pcfID)
bpo:OrphanProcess a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom bpo:CompetitorAnalysis ] .

# V-S6: a process subclassed UNDER another process (taxonomy-from-partonomy error)
bpo:GoodAnchorProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom bpo:CompetitorAnalysis ] ;
    rdfs:label "anchor proc" ; skos:definition "x" ; bpo:pcfID "1" ; skos:example "e" .
bpo:BadSubsumedProcess a owl:Class ;
    rdfs:subClassOf bpo:GoodAnchorProcess ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom bpo:CompetitorAnalysis ] ;
    rdfs:label "bad sub" ; skos:definition "x" ; bpo:pcfID "2" ; skos:example "e" .

# V-S3: has output filler is a Role, not an ICE
bpo:BadOutputProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom bpo:CompetitorRole ] ;
    rdfs:label "bad out" ; skos:definition "x" ; bpo:pcfID "3" ; skos:example "e" .

# V-S5: has process part filler is Data (not a process)
bpo:BadWholeProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001777 ; owl:someValuesFrom bpo:CompetitorData ] ;
    rdfs:label "bad whole" ; skos:definition "x" ; bpo:pcfID "4" ; skos:example "e" .

# V-S7: an ICE class that bears a Role
bpo:RoleBearingICE a owl:Class ;
    rdfs:subClassOf cco:ont00000853 ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom bpo:CompetitorRole ] .

# V-S8: a process (non-ICE) carrying an 'is about' restriction
bpo:AboutOnProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom bpo:CompetitorAnalysis ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom bpo:Competitor ] ;
    rdfs:label "about proc" ; skos:definition "x" ; bpo:pcfID "5" ; skos:example "e" .

# W-S4: has input filler is neither ICE nor material entity (a Role)
bpo:WeirdInputProcess a owl:Class ;
    rdfs:subClassOf cco:ont00000366 ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom bpo:CompetitorRole ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom bpo:CompetitorAnalysis ] ;
    rdfs:label "weird in" ; skos:definition "x" ; bpo:pcfID "6" ; skos:example "e" .
